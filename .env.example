# ---------- Sunucu (apps/server) ----------
PORT=4000
# Tarayıcı kökeni; üretimde web adresinizi yazın
CORS_ORIGIN=*
# DATA_DIR=./data

# auto = hacim + günlük harekete göre otomatik seçim (sadece kripto perpetual; hisse/emtia hariç)
# ya da virgüllü liste: SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SYMBOLS=auto
UNIVERSE_SIZE=50
UNIVERSE_MIN_VOLUME=50000000
# İzleme listesi eğilimi için aralıklar (AL/SAT sinyalleri her zaman 1s konsensüsten gelir)
SIGNAL_INTERVALS=1h

# ---------- Konsensüs (tüm analizlerin birleşimi) ----------
# Haftalık/günlük/4s/1s/15dk trend + gün/hafta açılışı + VWAP + 3 strateji oylanır.
# Sinyal: konsensüs ≥ eşik ve en az bir strateji tetiklenmiş olmalı.
CONSENSUS_THRESHOLD=70
# Konsensüs bunun altına inince SAT uyarısı (short değil; alma / long'unu kontrol et)
CONSENSUS_EXIT_ALERT=-70

# Kapı: 1s ADX bunun altındaysa sinyal ve plan yok (analiz paneli de BEKLE der)
CONSENSUS_MIN_ADX=18
# GÜÇLÜ AL (A+) için gereken ADX
CONSENSUS_APLUS_MIN_ADX=25

# ---------- Strateji ve sinyal kapısı ----------
# AL yalnızca kapının TÜM kontrolleri geçince: konsensüs ≥ eşik, tetikleyici strateji, ADX ≥ CONSENSUS_MIN_ADX, RSI ≤ 75.
# Plan: stop = son 8 mum dibi − 0.25×ATR (1–2.5 ATR arası), hedef = giriş + SIGNAL_RR × risk.
# "Trend devamı" stratejisinin kendi ayarları:
SIGNAL_MIN_SCORE=4
SIGNAL_MIN_ADX=20
SIGNAL_REQUIRE_HTF=true
SIGNAL_ATR_SL=1.5
SIGNAL_RR=1.5
# Fiyat bu kadar R kâra geçince stop GİRİŞE çekilir (0 = kapalı); başa baş çıkış ücret kadar eksidir
SIGNAL_BREAKEVEN_R=1
# SHORT sinyalleri (geçmiş testlerde zararda; kapalıyken short butonu da gizlenir)
SIGNAL_ALLOW_SHORT=false
# Pozisyon KAPANDIKTAN sonra aynı coinde yeni sinyal için beklenecek mum sayısı
SIGNAL_COOLDOWN=6
# TP/SL görmeyen sinyalin kaç mum sonra kapanacağı (zaman stopu)
SIGNAL_EXPIRY=48

# ---------- Seçici mod ve canlı karne ----------
# Sadece A+ sinyallere bildirim ve işlem butonu (arayüz her açılışta bu değere döner)
SELECTIVE_APLUS_ONLY=true
# Canlı karne başlangıcı (bundan önceki sinyaller sayılmaz; değiştirilirse karne sıfırlanır)
TRACKING_START=2026-10-01T13:54:00Z
# Canlı karnede bot bakiyesi: işlem başına riske edilen bakiye yüzdesi
LIVE_RISK_PCT=1

# ---------- Backtest maliyet modeli ----------
# Her işlemde giriş + çıkış taker ücreti ve kayma (taraf başına): toplam 2 × (0.05 + 0.02) = %0.14
COST_TAKER_FEE_PCT=0.05
COST_SLIPPAGE_PCT=0.02
# Örneklem dışı (walk-forward) dönem: kurallar bu dönemi görmeden seçildi; karneler buradan
OOS_FROM=2025-07-01T00:00:00Z
OOS_TO=2026-02-01T00:00:00Z

# ---------- Kaldıraç ----------
# İzin verilen en yüksek kaldıraç (arayüz varsayılanı 1x)
MAX_LEVERAGE=5

# ---------- Risk kalkanı (tek tıkla işlem) ----------
GUARD_ENABLED=true
GUARD_MAX_OPEN=5
GUARD_DAY_STOP_LOSSES=2
GUARD_BREAKER_LOSSES=4
GUARD_PAUSE_DAYS=3
# BTC günlük trendi yukarı değilse yeni long yok
GUARD_REQUIRE_BTC_UP=true

# ---------- İşlem modu ----------
# paper   = simülasyon hesabı (varsayılan, gerçek para yok)
# binance = gerçek Binance USDⓈ-M Futures hesabı
TRADING_MODE=paper

PAPER_INITIAL_BALANCE=100
PAPER_TAKER_FEE=0.0005
PAPER_MAKER_FEE=0.0002
PAPER_MAINT_MARGIN_RATE=0.005

# Sadece TRADING_MODE=binance için. API anahtarında SADECE "Futures" izni açık olsun,
# "Withdraw" (çekim) iznini ASLA açmayın ve IP kısıtlaması koyun.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Önce testnet ile deneyin: https://demo-fapi.binance.com
BINANCE_TRADE_REST=https://fapi.binance.com

# ---------- Web (web/) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
